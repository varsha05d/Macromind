<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Spacer -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <!-- Animated emoji -->
        <TextView
            android:id="@+id/splashEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔬"
            android:textSize="96sp" />

        <!-- App name -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MacroMind"
            android:textColor="#1A1D26"
            android:textSize="42sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:layout_marginTop="20dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Food Health Analyzer"
            android:textColor="#2563EB"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100% Offline · On-Device AI"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <!-- Spacer -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Version -->
        <TextView
            android:id="@+id/splashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v5.0"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</FrameLayout>
